# ERRAND GHANA Environment Configuration
# Node.js Express Server Configuration
PORT=3001
NODE_ENV=development

# Optional Supabase Database Connection
# If left empty or unconfigured, ERRAND GHANA seamlessly operates with resilient in-memory state persistence
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mobile Money Simulation Gateway Settings
MOMO_SIMULATED_LATENCY_MS=600
PLATFORM_ESCROW_FEE_PERCENT=2.0
ML_BENCHMARK_SUPERMARKET_MULTIPLIER=1.18
